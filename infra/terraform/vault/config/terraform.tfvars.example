# Copy this to terraform.tfvars and fill in real values. terraform.tfvars
# is gitignored on purpose — it's the only place these secrets exist
# outside Vault itself, so it must never be committed.

vault_addr         = "http://<VAULT_PRIVATE_IP>:8200"
kubernetes_host    = "https://<K8S_MASTER_IP>:6443"
kubernetes_ca_cert = <<EOT
-----BEGIN CERTIFICATE-----
...contents of /etc/kubernetes/pki/ca.crt on the master node...
-----END CERTIFICATE-----
EOT
token_reviewer_jwt = "<output of: kubectl create token vault-auth -n kube-system --duration=8760h>"

postgres_user     = "postgres"
postgres_password = "<pick a real one, not the old committed value>"
postgres_db       = "hospital_db"
app_secret_key    = "<a fresh random signing key, not the old committed value>"

# IAM user Vault itself uses to mint short-lived credentials for everyone
# else — see the comment on these variables in variables.tf before
# creating it. Not the same thing as the temp creds this engine hands out.
vault_aws_root_access_key = "<AKIA... belonging to a narrowly-scoped IAM user, not your personal/root key>"
vault_aws_root_secret_key = "<its secret key>"
aws_region                = "us-east-1"
