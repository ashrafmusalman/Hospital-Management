pipeline {
    agent {
        label "build"
    }

    environment {
        DOCKER_USER = "ashrafkhan0277"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '1'))
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {

        stage("Checkout") {
            steps {
                git credentialsId: 'githubPat',
                    url: 'https://github.com/ashrafmusalman/doctor-api.git',
                    branch: 'main'
            }
        }

        stage("Build") {
            parallel {
                stage("Backend") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-backend:${BUILD_NUMBER} -f backend/Dockerfile backend/"
                    }
                }
                stage("Admin") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-admin:${BUILD_NUMBER} -f frontend/admin/Dockerfile frontend/admin/"
                    }
                }
                stage("User") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-user:${BUILD_NUMBER} -f frontend/user/Dockerfile frontend/user/"
                    }
                }
            }
        }

        stage("Push") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "dockerHubPat",
                    usernameVariable: "DOCKER_HUB_USER",
                    passwordVariable: "DOCKER_HUB_PASS"
                )]) {
                    sh 'echo $DOCKER_HUB_PASS | docker login -u $DOCKER_HUB_USER --password-stdin'
                    sh """
                        docker push ${DOCKER_USER}/hospital-backend:${BUILD_NUMBER}
                        docker push ${DOCKER_USER}/hospital-admin:${BUILD_NUMBER}
                        docker push ${DOCKER_USER}/hospital-user:${BUILD_NUMBER}
                    """
                }
            }
        }

        stage("Update Manifest") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "githubPat",
                    usernameVariable: "GIT_USER",
                    passwordVariable: "GIT_PASS"
                )]) {
                    sh """
                        git clone https://\${GIT_USER}:\${GIT_PASS}@github.com/ashrafmusalman/doctor-api.git repo
                        cd repo

                        sed -i 's|${DOCKER_USER}/hospital-backend:.*|${DOCKER_USER}/hospital-backend:${BUILD_NUMBER}|g' k8s/api/deployment.yaml
                        sed -i 's|${DOCKER_USER}/hospital-admin:.*|${DOCKER_USER}/hospital-admin:${BUILD_NUMBER}|g' k8s/admin/deployment.yaml
                        sed -i 's|${DOCKER_USER}/hospital-user:.*|${DOCKER_USER}/hospital-user:${BUILD_NUMBER}|g' k8s/user/deployment.yaml

                        git config user.email "jenkins@ci.local"
                        git config user.name "Jenkins CI"

                        git add k8s/api/deployment.yaml k8s/admin/deployment.yaml k8s/user/deployment.yaml
                        git diff --staged --quiet || git commit -m "ci: update image tags to build ${BUILD_NUMBER} [skip ci]"
                        git push https://\${GIT_USER}:\${GIT_PASS}@github.com/ashrafmusalman/doctor-api.git HEAD:main
                    """
                }
            }
        }

    }

    post {
        success {
            echo "Build ${BUILD_NUMBER} pushed to Docker Hub successfully"
        }
        failure {
            echo "Pipeline failed at build ${BUILD_NUMBER}"
        }
        always {
            sh """
                docker logout || true
                rm -rf repo || true
            """
        }
    }
}