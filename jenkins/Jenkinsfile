pipeline {
    agent any

    environment {
        DOCKER_USER  = "ashrafkhan0277"
        BUILD_TAG    = "${BUILD_NUMBER}"
        KUBECONFIG   = "/var/lib/jenkins/.kube/config"
    }

    stages {

        stage("Build Images") {
            parallel {
                stage("Build Backend") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-backend:${BUILD_TAG} -f backend/Dockerfile backend/"
                        echo "Backend image built"
                    }
                }
                stage("Build Admin Frontend") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-admin:${BUILD_TAG} -f frontend/admin/Dockerfile frontend/admin/"
                        echo "Admin frontend image built"
                    }
                }
                stage("Build User Frontend") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-user:${BUILD_TAG} -f frontend/user/Dockerfile frontend/user/"
                        echo "User frontend image built"
                    }
                }
            }
        }

        stage("Docker Hub Login") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "Jenkin-PAT",
                    usernameVariable: "DOCKER_HUB_USER",
                    passwordVariable: "DOCKER_HUB_PASS"
                )]) {
                    sh "echo $DOCKER_HUB_PASS | docker login -u $DOCKER_HUB_USER --password-stdin"
                }
            }
        }

        stage("Push Images") {
            parallel {
                stage("Push Backend") {
                    steps {
                        sh "docker push ${DOCKER_USER}/hospital-backend:${BUILD_TAG}"
                    }
                }
                stage("Push Admin Frontend") {
                    steps {
                        sh "docker push ${DOCKER_USER}/hospital-admin:${BUILD_TAG}"
                    }
                }
                stage("Push User Frontend") {
                    steps {
                        sh "docker push ${DOCKER_USER}/hospital-user:${BUILD_TAG}"
                    }
                }
            }
        }

        stage("Deploy to Kubernetes") {
            steps {
                sh """
                    echo "--- Networking, RBAC, Config first ---"
                    kubectl apply -f k8s/networking/
                    kubectl apply -f k8s/rbac/
                    kubectl apply -f k8s/config/

                    echo "--- Database ---"
                    kubectl apply -f k8s/database/

                    echo "--- App layers ---"
                    kubectl apply -f k8s/api/
                    kubectl apply -f k8s/user/
                    kubectl apply -f k8s/admin/

                    echo "--- Monitoring ---"
                    kubectl apply -f k8s/monitoring/

                    echo "--- Update images to build ${BUILD_TAG} ---"
                    kubectl set image deployment/hospital-backend \
                        hospital-backend=${DOCKER_USER}/hospital-backend:${BUILD_TAG}

                    kubectl set image deployment/hospital-admin \
                        hospital-admin=${DOCKER_USER}/hospital-admin:${BUILD_TAG}

                    kubectl set image deployment/hospital-user \
                        hospital-user=${DOCKER_USER}/hospital-user:${BUILD_TAG}

                    echo "--- Waiting for rollouts ---"
                    kubectl rollout status deployment/hospital-backend --timeout=120s
                    kubectl rollout status deployment/hospital-admin   --timeout=120s
                    kubectl rollout status deployment/hospital-user    --timeout=120s
                """
            }
        }

        stage("Verify") {
            steps {
                sh """
                    kubectl get pods -o wide
                    kubectl get svc
                    kubectl get deployments
                """
            }
        }
    }

    post {
        success {
            echo "All 3 services deployed — Build ${BUILD_TAG}"
        }
        failure {
            echo "Pipeline FAILED — rolling back"
            sh """
                kubectl rollout undo deployment/hospital-backend || true
                kubectl rollout undo deployment/hospital-admin   || true
                kubectl rollout undo deployment/hospital-user    || true
            """
        }
        always {
            sh "docker logout || true"
        }
    }
}