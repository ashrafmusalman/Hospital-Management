pipeline {
    agent any

    environment {
        DOCKER_USER = "ashrafkhan0277"
        BUILD_TAG   = "${BUILD_NUMBER}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
    }

    stages {

        stage("Build Images") {
            parallel {
                stage("Build Backend") {
                    steps {
                        sh """
                            docker build \
                                -t ${DOCKER_USER}/hospital-backend:${BUILD_TAG} \
                                -t ${DOCKER_USER}/hospital-backend:latest \
                                -f backend/Dockerfile backend/
                        """
                        echo "Backend built"
                    }
                }
                stage("Build Admin") {
                    steps {
                        sh """
                            docker build \
                                -t ${DOCKER_USER}/hospital-admin:${BUILD_TAG} \
                                -t ${DOCKER_USER}/hospital-admin:latest \
                                -f frontend/admin/Dockerfile frontend/admin/
                        """
                        echo "Admin built"
                    }
                }
                stage("Build User") {
                    steps {
                        sh """
                            docker build \
                                -t ${DOCKER_USER}/hospital-user:${BUILD_TAG} \
                                -t ${DOCKER_USER}/hospital-user:latest \
                                -f frontend/user/Dockerfile frontend/user/
                        """
                        echo "User built"
                    }
                }
            }
        }

        stage("Docker Hub Login") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "Jenkin-PAT",
                    usernameVariable: "DOCKER_HUB_USER",
                    passwordVariable: "DOCKER_HUB_PASS"
                )]) {
                    sh 'echo $DOCKER_HUB_PASS | docker login -u $DOCKER_HUB_USER --password-stdin'
                }
            }
        }

        stage("Push Images") {
            parallel {
                stage("Push Backend") {
                    steps {
                        sh """
                            docker push ${DOCKER_USER}/hospital-backend:${BUILD_TAG}
                            docker push ${DOCKER_USER}/hospital-backend:latest
                        """
                        echo "Backend pushed"
                    }
                }
                stage("Push Admin") {
                    steps {
                        sh """
                            docker push ${DOCKER_USER}/hospital-admin:${BUILD_TAG}
                            docker push ${DOCKER_USER}/hospital-admin:latest
                        """
                        echo "Admin pushed"
                    }
                }
                stage("Push User") {
                    steps {
                        sh """
                            docker push ${DOCKER_USER}/hospital-user:${BUILD_TAG}
                            docker push ${DOCKER_USER}/hospital-user:latest
                        """
                        echo "User pushed"
                    }
                }
            }
        }

        stage("Update Image Tags in Git") {
            steps {
                sh """
                    echo "--- Injecting build tag ${BUILD_TAG} into YAMLs ---"

                    sed -i 's|${DOCKER_USER}/hospital-backend:.*|${DOCKER_USER}/hospital-backend:${BUILD_TAG}|g' \
                        k8s/api/deployment.yaml

                    sed -i 's|${DOCKER_USER}/hospital-admin:.*|${DOCKER_USER}/hospital-admin:${BUILD_TAG}|g' \
                        k8s/admin/deployment.yaml

                    sed -i 's|${DOCKER_USER}/hospital-user:.*|${DOCKER_USER}/hospital-user:${BUILD_TAG}|g' \
                        k8s/user/deployment.yaml

                    echo "--- Verifying tags ---"
                    grep 'image:' k8s/api/deployment.yaml
                    grep 'image:' k8s/admin/deployment.yaml
                    grep 'image:' k8s/user/deployment.yaml
                """

                // Commit and push updated YAMLs back to Git
                // ArgoCD watches this repo and auto-syncs the new tags
                withCredentials([usernamePassword(
                    credentialsId: "github-pat",
                    usernameVariable: "GIT_USER",
                    passwordVariable: "GIT_PASS"
                )]) {
                    sh """
                        git config user.email "jenkins@ci.local"
                        git config user.name "Jenkins CI"
                        git add k8s/api/deployment.yaml k8s/admin/deployment.yaml k8s/user/deployment.yaml
                        git diff --staged --quiet || git commit -m "ci: update image tags to build ${BUILD_TAG} [skip ci]"
                        git push https://\${GIT_USER}:\${GIT_PASS}@github.com/ashrafmusalman/doctor-api.git HEAD:main
                    """
                }
            }
        }

    }

    post {
        success {
            echo "CI complete — Build ${BUILD_TAG} images pushed to Docker Hub. ArgoCD will sync and deploy automatically."
        }
        failure {
            echo "Pipeline FAILED — Build ${BUILD_TAG} — no deployment triggered."
        }
        always {
            sh """
                docker logout || true
                docker image prune -f || true
            """
        }
    }
}