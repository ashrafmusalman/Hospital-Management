pipeline {
    agent any

    environment {
        DOCKER_USER = "ashrafkhan0277"
        BUILD_TAG   = "${BUILD_NUMBER}"
        KUBECONFIG  = "/var/lib/jenkins/.kube/config"
        NAMESPACE   = "hospital"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
    }

    stages {

        stage("Build Images") {
            parallel {
                stage("Build Backend") {
                    steps {
                        sh """
                            docker build \
                                -t ${DOCKER_USER}/hospital-backend:${BUILD_TAG} \
                                -t ${DOCKER_USER}/hospital-backend:latest \
                                -f backend/Dockerfile backend/
                        """
                        echo "Backend built"
                    }
                }
                stage("Build Admin") {
                    steps {
                        sh """
                            docker build \
                                -t ${DOCKER_USER}/hospital-admin:${BUILD_TAG} \
                                -t ${DOCKER_USER}/hospital-admin:latest \
                                -f frontend/admin/Dockerfile frontend/admin/
                        """
                        echo "Admin built"
                    }
                }
                stage("Build User") {
                    steps {
                        sh """
                            docker build \
                                -t ${DOCKER_USER}/hospital-user:${BUILD_TAG} \
                                -t ${DOCKER_USER}/hospital-user:latest \
                                -f frontend/user/Dockerfile frontend/user/
                        """
                        echo "User built"
                    }
                }
            }
        }

        stage("Docker Hub Login") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "Jenkin-PAT",
                    usernameVariable: "DOCKER_HUB_USER",
                    passwordVariable: "DOCKER_HUB_PASS"
                )]) {
                    sh 'echo $DOCKER_HUB_PASS | docker login -u $DOCKER_HUB_USER --password-stdin'
                }
            }
        }

        stage("Push Images") {
            parallel {
                stage("Push Backend") {
                    steps {
                        sh """
                            docker push ${DOCKER_USER}/hospital-backend:${BUILD_TAG}
                            docker push ${DOCKER_USER}/hospital-backend:latest
                        """
                        echo "Backend pushed"
                    }
                }
                stage("Push Admin") {
                    steps {
                        sh """
                            docker push ${DOCKER_USER}/hospital-admin:${BUILD_TAG}
                            docker push ${DOCKER_USER}/hospital-admin:latest
                        """
                        echo "Admin pushed"
                    }
                }
                stage("Push User") {
                    steps {
                        sh """
                            docker push ${DOCKER_USER}/hospital-user:${BUILD_TAG}
                            docker push ${DOCKER_USER}/hospital-user:latest
                        """
                        echo "User pushed"
                    }
                }
            }
        }

        stage("Update Image Tags in YAML") {
            steps {
                sh """
                    echo "--- Injecting build tag ${BUILD_TAG} into YAMLs ---"

                    sed -i 's|${DOCKER_USER}/hospital-backend:.*|${DOCKER_USER}/hospital-backend:${BUILD_TAG}|g' \
                        k8s/api/deployment.yaml

                    sed -i 's|${DOCKER_USER}/hospital-admin:.*|${DOCKER_USER}/hospital-admin:${BUILD_TAG}|g' \
                        k8s/admin/deployment.yaml

                    sed -i 's|${DOCKER_USER}/hospital-user:.*|${DOCKER_USER}/hospital-user:${BUILD_TAG}|g' \
                        k8s/user/deployment.yaml

                    echo "--- Verifying tags ---"
                    grep 'image:' k8s/api/deployment.yaml
                    grep 'image:' k8s/admin/deployment.yaml
                    grep 'image:' k8s/user/deployment.yaml
                """
            }
        }

        stage("Deploy to Kubernetes") {
            steps {
                sh """
                    echo "--- Creating namespace ---"
                    kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

                    echo "--- Foundation layer ---"
                    kubectl apply -f k8s/networking/ -n ${NAMESPACE}
                    kubectl apply -f k8s/rbac/       -n ${NAMESPACE}
                    kubectl apply -f k8s/config/     -n ${NAMESPACE}

                    echo "--- Database ---"
                    kubectl apply -f k8s/database/ -n ${NAMESPACE}

                    echo "--- Application ---"
                    kubectl apply -f k8s/api/   -n ${NAMESPACE}
                    kubectl apply -f k8s/user/  -n ${NAMESPACE}
                    kubectl apply -f k8s/admin/ -n ${NAMESPACE}

                    echo "--- Monitoring ---"
                    kubectl apply -f k8s/monitoring/ -n ${NAMESPACE} || true

                    echo "--- Deploy submitted to Kubernetes ---"
                """
            }
        }

        stage("Verify") {
            steps {
                sh """
                    echo "--- Deployment image tags ---"
                    kubectl get deployments -n ${NAMESPACE} \
                        -o custom-columns=\
NAME:.metadata.name,\
IMAGE:.spec.template.spec.containers[0].image,\
READY:.status.readyReplicas,\
AVAILABLE:.status.availableReplicas

                    echo "--- Pod status ---"
                    kubectl get pods -n ${NAMESPACE} -o wide

                    echo "--- Services ---"
                    kubectl get svc -n ${NAMESPACE}

                    echo "--- Ingress ---"
                    kubectl get ingress -n ${NAMESPACE}
                """
            }
        }

    }

    post {
        success {
            echo "Build ${BUILD_TAG} delivered — Kubernetes rolling out in background"
        }
        failure {
            echo "Pipeline FAILED — Build ${BUILD_TAG} — rolling back"
            sh """
                kubectl rollout undo deployment/hospital-api   -n ${NAMESPACE} || true
                kubectl rollout undo deployment/hospital-admin -n ${NAMESPACE} || true
                kubectl rollout undo deployment/hospital-user  -n ${NAMESPACE} || true
            """
        }
        always {
            sh """
                docker logout || true
                docker image prune -f || true
            """
        }
    }
}