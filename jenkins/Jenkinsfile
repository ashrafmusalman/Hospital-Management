pipeline {
    agent any

    environment {
        DOCKER_USER  = "ashrafkhan0277"
        BUILD_TAG    = "${BUILD_NUMBER}"
        KUBECONFIG   = "/var/lib/jenkins/.kube/config"
        NAMESPACE    = "hospital"
    }

    stages {

        stage("Build Images") {
            parallel {
                stage("Build Backend") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-backend:${BUILD_TAG} -f backend/Dockerfile backend/"
                        echo "Backend image built"
                    }
                }
                stage("Build Admin Frontend") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-admin:${BUILD_TAG} -f frontend/admin/Dockerfile frontend/admin/"
                        echo "Admin frontend image built"
                    }
                }
                stage("Build User Frontend") {
                    steps {
                        sh "docker build -t ${DOCKER_USER}/hospital-user:${BUILD_TAG} -f frontend/user/Dockerfile frontend/user/"
                        echo "User frontend image built"
                    }
                }
            }
        }

        stage("Docker Hub Login") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "Jenkin-PAT",
                    usernameVariable: "DOCKER_HUB_USER",
                    passwordVariable: "DOCKER_HUB_PASS"
                )]) {
                    sh 'echo $DOCKER_HUB_PASS | docker login -u $DOCKER_HUB_USER --password-stdin'
                }
            }
        }

        stage("Push Images") {
            parallel {
                stage("Push Backend") {
                    steps {
                        sh "docker push ${DOCKER_USER}/hospital-backend:${BUILD_TAG}"
                        echo "Backend pushed"
                    }
                }
                stage("Push Admin Frontend") {
                    steps {
                        sh "docker push ${DOCKER_USER}/hospital-admin:${BUILD_TAG}"
                        echo "Admin pushed"
                    }
                }
                stage("Push User Frontend") {
                    steps {
                        sh "docker push ${DOCKER_USER}/hospital-user:${BUILD_TAG}"
                        echo "User pushed"
                    }
                }
            }
        }

        stage("Deploy to Kubernetes") {
            steps {
                sh """
                    echo "--- Creating namespace if not exists ---"
                    kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

                    echo "--- Applying networking, RBAC, config first ---"
                    kubectl apply -f k8s/networking/ -n ${NAMESPACE}
                    kubectl apply -f k8s/rbac/       -n ${NAMESPACE}
                    kubectl apply -f k8s/config/     -n ${NAMESPACE}

                    echo "--- Applying database ---"
                    kubectl apply -f k8s/database/ -n ${NAMESPACE}

                    echo "--- Applying app layers ---"
                    kubectl apply -f k8s/api/   -n ${NAMESPACE}
                    kubectl apply -f k8s/user/  -n ${NAMESPACE}
                    kubectl apply -f k8s/admin/ -n ${NAMESPACE}

                    echo "--- Applying monitoring (skip CRD errors) ---"
                    kubectl apply -f k8s/monitoring/ -n ${NAMESPACE} || true

                    echo "--- Updating images to build ${BUILD_TAG} ---"
                    kubectl set image deployment/hospital-api \
                        hospital-api=${DOCKER_USER}/hospital-backend:${BUILD_TAG} \
                        -n ${NAMESPACE}

                    kubectl set image deployment/hospital-admin \
                        hospital-admin=${DOCKER_USER}/hospital-admin:${BUILD_TAG} \
                        -n ${NAMESPACE}

                    kubectl set image deployment/hospital-user \
                        hospital-user=${DOCKER_USER}/hospital-user:${BUILD_TAG} \
                        -n ${NAMESPACE}

                    echo "--- Waiting for rollouts ---"
                    kubectl rollout status deployment/hospital-api   --timeout=120s -n ${NAMESPACE}
                    kubectl rollout status deployment/hospital-admin --timeout=120s -n ${NAMESPACE}
                    kubectl rollout status deployment/hospital-user  --timeout=120s -n ${NAMESPACE}
                """
            }
        }

        stage("Verify") {
            steps {
                sh """
                    echo "--- Pods ---"
                    kubectl get pods -n ${NAMESPACE} -o wide

                    echo "--- Services ---"
                    kubectl get svc -n ${NAMESPACE}

                    echo "--- Deployments ---"
                    kubectl get deployments -n ${NAMESPACE}

                    echo "--- Ingress ---"
                    kubectl get ingress -n ${NAMESPACE}
                """
            }
        }

    }

    post {
        success {
            echo "Pipeline SUCCESS — Build ${BUILD_TAG} deployed to ${NAMESPACE}"
        }
        failure {
            echo "Pipeline FAILED — Build ${BUILD_TAG} — rolling back"
            sh """
                kubectl rollout undo deployment/hospital-api   -n ${NAMESPACE} || true
                kubectl rollout undo deployment/hospital-admin -n ${NAMESPACE} || true
                kubectl rollout undo deployment/hospital-user  -n ${NAMESPACE} || true
            """
        }
        always {
            sh "docker logout || true"
            echo "Pipeline finished — Build ${BUILD_TAG}"
        }
    }
}